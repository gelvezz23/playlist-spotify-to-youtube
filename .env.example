# Spotify: crea una app en https://developer.spotify.com/dashboard
# Redirect URI que debes añadir: http://localhost:5173/
SPOTIFY_CLIENT_ID=

# Google: crea un proyecto en https://console.cloud.google.com
# Activa "YouTube Data API v3" y crea credenciales OAuth 2.0 (tipo Web).
# Origen JavaScript autorizado: http://localhost:5173
GOOGLE_CLIENT_ID=
